# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="att-web API"
ENVIRONMENT=dev

# ── Database ─────────────────────────────────────────────────────────────────
# DEV (this laptop): local SQLite file, zero setup.
DATABASE_URL=sqlite:///./attendance.db
# PRODUCTION (other laptop / cloud): Postgres + pgvector, e.g. from Neon/Supabase:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate a strong random value for production. Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Face model ───────────────────────────────────────────────────────────────
FACE_MODEL_NAME=buffalo_s
FACE_DET_SIZE=320
FACE_DET_THRESHOLD=0.5
# Stricter than the camera's 0.4 because a field selfie is static and self-service.
FIELD_MATCH_THRESHOLD=0.45

# ── Geofence ─────────────────────────────────────────────────────────────────
# Reject a field scan if the phone's GPS accuracy is worse than this (metres).
GPS_MAX_ACCURACY_M=100

# ── Edge ingestion ───────────────────────────────────────────────────────────
# Shared secret the edge pipeline sends with POST /events.
EDGE_API_KEY=change-me-edge-key

# ── Timezone (display only; storage is always UTC) ───────────────────────────
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Attendance policy (edit freely; restart backend to apply) ────────────────
# Office shift deadline (local IST, HH:MM). First OFFICE arrival at/before
# SHIFT_START + grace = present; after = late. Field scans are never late.
SHIFT_START=09:30
LATE_GRACE_MINUTES=10
# Working days (others are treated as weekend, so no "absent" is shown).
WORKING_DAYS=mon,tue,wed,thu,fri,sat
# Which camera_label means entry vs exit (2 entry + 2 exit here). The edge also
# sends `direction` per event; this map is the fallback if it doesn't.
CAMERA_DIRECTIONS=gate-in-1:entry,gate-in-2:entry,gate-out-1:exit,gate-out-2:exit

# ── CORS: where the frontend is served from ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
